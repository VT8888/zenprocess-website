---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vinhPhoto from '../assets/vinh-photo.jpg';

const credentials = [
  { label: 'Experience', title: '20+ years VP of IT & CTO leadership', sub: 'Harris Health System, HISD, Stewart Title, and more' },
  { label: 'Scale', title: '$80M+ in technology initiatives', sub: "Including HISD's $80M PowerUp initiative across 194 schools" },
  { label: 'Education', title: 'M.S. Cybersecurity & Information Assurance', sub: 'Graduate courses at Harvard University · AI certificates from Stanford' },
  { label: 'Security Certifications', title: 'CISSP · CEH · ACCISO · ITIL', sub: 'CCNP · MCSE' },
  { label: 'Compliance', title: 'HIPAA · SOX · PCI-DSS · NIST · GDPR', sub: 'Regulated healthcare and financial environments' },
  { label: 'Enterprise Systems', title: 'SAP · Epic EMR · AWS · Azure · M365', sub: 'Cloud migration, data pipelines, custom dashboards' },
];
---

<Layout
  title="About zenprocess.ai | Built by Vinh Truong"
  description="Vinh Truong, Co-Founder & AI Architect. 20+ years leading enterprise IT as a VP and CTO. Builder of OwnerOS and ERP Intelligence."
>
  <section class="about-hero">
    <div class="wrap about-grid">
      <div class="about-copy">
        <span class="kicker">About</span>
        <h1 class="about-title">About zenprocess.ai</h1>
        <p class="about-para">I spent more than 20 years leading enterprise IT as a VP and CTO, building systems that businesses relied on every day. Those systems supported thousands of users, managed complex operations, and helped leaders make better decisions.</p>
        <p class="about-para">As I began working with small businesses and distributors, I saw the same problem in different forms.</p>
        <p class="about-para">Business owners were jumping between email, calendars, accounting software, and CRMs just to figure out what needed their attention.</p>
        <p class="about-para">Distributors had powerful ERP systems but were still relying on spreadsheets to manage purchasing, inventory, and warehouse operations because the information they needed wasn't easy to see or act on.</p>
        <p class="about-para">Different businesses. Same challenge.</p>
        <p class="about-para">People weren't short on data. They were short on clarity.</p>
        <p class="about-para">That's why I built <strong>OwnerOS</strong> and <strong>ERP Intelligence</strong>.</p>
        <p class="about-para"><strong>OwnerOS</strong> helps owner-led businesses start each day with one clear view of what needs attention, what's at risk, and what to do next.</p>
        <p class="about-para"><strong>ERP Intelligence</strong> helps distributors turn ERP data into live operational dashboards that improve purchasing decisions, inventory performance, and cash flow.</p>
        <p class="about-para">Both products are built on the same philosophy.</p>
        <p class="about-para">Give business owners and operators clear information, practical recommendations, and the confidence to make better decisions without adding more software to manage.</p>
        <p class="about-para">When you work with zenprocess.ai, you're not handed off to another team. I work directly with every client, leading the architecture, product design, and implementation from start to finish.</p>
      </div>

      <aside class="card profile-card text-center">
        <Image src={vinhPhoto} alt="Vinh Truong" width={480} height={640} class="vinh-photo" />
        <h3 class="vinh-name">Vinh Truong</h3>
        <p class="eyebrow vinh-title">Co-Founder &amp; AI Architect</p>
        <a
          href="https://www.linkedin.com/in/vttruong/"
          target="_blank"
          rel="noopener noreferrer"
          class="linkedin-btn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path fill="#0A66C2" d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2z"/><path fill="#fff" d="M6.94 8.58a1.56 1.56 0 1 0 0-3.12 1.56 1.56 0 0 0 0 3.12zM5.5 9.75h2.88V18.5H5.5zM10.13 9.75h2.76v1.2h.04c.38-.72 1.32-1.48 2.72-1.48 2.91 0 3.45 1.92 3.45 4.41v4.62h-2.88v-4.09c0-.98-.02-2.23-1.36-2.23-1.36 0-1.57 1.06-1.57 2.16v4.16h-2.88z"/></svg>
          LinkedIn Profile
        </a>
      </aside>
    </div>
  </section>

  <section class="about-section reveal">
    <div class="wrap">
      <h2 class="section-title text-center">Credentials</h2>
      <div class="cred-grid">
        {credentials.map((c) => (
          <div class="card cred-card">
            <p class="kicker cred-label">{c.label}</p>
            <p class="cred-title">{c.title}</p>
            <p class="cred-sub">{c.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section reveal text-center">
    <div class="wrap about-cta">
      <h2 class="about-cta-title">Want to talk?</h2>
      <p class="about-cta-sub">I'm happy to spend 30 minutes understanding your operation. No sales pitch.</p>
      <a href="https://links.zenprocess.ai/widget/booking/rcoKJifJJA46bRI9fTEr" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">Book a call</a>
      <p class="about-cta-contact">Or email <a href="mailto:info@zenprocess.ai">info@zenprocess.ai</a> · <a href="tel:+18329742818">(832) 974-2818</a></p>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding-top: 80px;
    padding-bottom: 40px;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr .72fr;
    gap: 56px;
    align-items: start;
  }
  .about-title {
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: 800;
    margin: 16px 0 22px;
  }
  .about-para {
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 18px;
  }
  .about-para strong {
    color: var(--ink);
    font-weight: 700;
  }
  .profile-card {
    padding: 28px;
    position: sticky;
    top: 88px;
  }
  .vinh-photo {
    width: 100%;
    max-width: 260px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: top;
    border-radius: 16px;
    margin: 0 auto 18px;
    border: 1px solid var(--line);
  }
  .vinh-name {
    font-size: 22px;
    font-weight: 800;
  }
  .vinh-title {
    margin-top: 2px;
  }
  .linkedin-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 9px 16px;
    border-radius: 10px;
    background: rgba(10, 102, 194, .10);
    border: 1px solid rgba(10, 102, 194, .25);
    color: #0A66C2;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background .18s;
  }
  .linkedin-btn:hover {
    background: rgba(10, 102, 194, .18);
  }
  .about-section {
    border-top: 1px solid var(--line);
  }
  .section-title {
    font-size: 30px;
    font-weight: 800;
    margin-bottom: 40px;
  }
  .cred-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .cred-card {
    padding: 24px;
  }
  .cred-label {
    margin-bottom: 8px;
  }
  .cred-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    margin-bottom: 6px;
  }
  .cred-sub {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
  }
  .about-cta {
    max-width: 640px;
  }
  .about-cta-title {
    font-size: clamp(28px, 3.6vw, 42px);
    font-weight: 800;
    margin-bottom: 14px;
  }
  .about-cta-sub {
    color: var(--ink-2);
    font-size: 18px;
    margin-bottom: 28px;
  }
  .btn-large {
    font-size: 16px;
    padding: 16px 28px;
  }
  .about-cta-contact {
    color: var(--muted);
    font-size: 15px;
    margin-top: 22px;
  }
  .about-cta-contact a {
    color: var(--green-d);
    text-decoration: none;
  }
  .about-cta-contact a:hover {
    text-decoration: underline;
  }
  @media (max-width: 1024px) {
    .cred-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr !important;
      gap: 32px;
    }
    .profile-card {
      position: static;
      order: -1;
      max-width: 420px;
    }
  }
  @media (max-width: 640px) {
    .cred-grid { grid-template-columns: 1fr; }
  }
</style>
