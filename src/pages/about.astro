---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vinhPhoto from '../assets/vinh-photo.jpg';
---

<Layout
  title="About zenprocess.ai | Built by Vinh Truong"
  description="20+ years enterprise IT and CTO leadership. Building real-time data systems for multi-warehouse distributors."
>
  <section class="about-hero">
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">About</span>
        <h1 class="hero-title">Built by someone who has done this before.</h1>
        <p class="hero-subtitle">I spent more than 20 years leading enterprise IT and building systems people relied on every day. I started zenprocess.ai to bring that same practical approach to owner-led businesses and distributors that have outgrown spreadsheets.</p>
      </div>
      <div class="card vinh-card text-center">
        <Image src={vinhPhoto} alt="Vinh Truong" width={96} height={96} class="vinh-photo" />
        <h3 class="vinh-name">Vinh Truong</h3>
        <p class="eyebrow">Co-Founder · zenprocess.ai</p>
      </div>
    </div>
  </section>

  <section class="about-section reveal">
    <div class="wrap about-wrap">
      <h2 class="section-title">Why this work</h2>
      <p class="about-para">Most companies don't need a new ERP or a new app. They need the truth in front of the team every morning. I build the layer that reads across what you already run and tells you what needs attention, with a human in control of anything that goes out.</p>
    </div>
  </section>

  <section class="about-section reveal">
    <div class="wrap">
      <h2 class="section-title text-center">Background</h2>
      <div class="stats">
        <div><div class="n">20+ yrs</div><div class="eyebrow">Enterprise IT & CTO leadership</div></div>
        <div><div class="n">$80M+</div><div class="eyebrow">in technology initiatives</div></div>
        <div><div class="n">CISSP · CEH</div><div class="eyebrow">security certifications</div></div>
        <div><div class="n">Harvard · Stanford</div><div class="eyebrow">executive education</div></div>
      </div>
    </div>
  </section>

  <section class="about-section reveal text-center">
    <div class="wrap about-cta">
      <h2 class="about-cta-title">Want to talk?</h2>
      <a href="https://links.zenprocess.ai/widget/booking/rcoKJifJJA46bRI9fTEr" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">Book a call</a>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding-top: 80px;
    padding-bottom: 40px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr .8fr;
    gap: 56px;
    align-items: center;
  }
  .hero-title {
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: 800;
    margin: 16px 0 18px;
  }
  .hero-subtitle {
    font-size: 19px;
    color: var(--ink-2);
  }
  .vinh-card {
    padding: 28px;
  }
  .vinh-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--green-tint);
    margin: 0 auto 16px;
    border: 1px solid var(--green-tint-2);
  }
  .vinh-name {
    font-size: 20px;
  }
  .about-section {
    border-top: 1px solid var(--line);
  }
  .about-wrap {
    max-width: 760px;
  }
  .section-title {
    font-size: 26px;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .about-para {
    color: var(--ink-2);
    font-size: 18px;
  }
  .about-cta {
    max-width: 640px;
  }
  .about-cta-title {
    font-size: clamp(28px, 3.6vw, 42px);
    font-weight: 800;
    margin-bottom: 16px;
  }
  .btn-large {
    font-size: 16px;
    padding: 16px 28px;
  }
  @media(max-width:860px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
      gap: 32px;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
  }
</style>
