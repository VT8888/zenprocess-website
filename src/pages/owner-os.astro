---
import Layout from '../layouts/Layout.astro';
import DashboardMockup from '../components/DashboardMockup.astro';

const BOOKING = "https://links.zenprocess.ai/widget/booking/rcoKJifJJA46bRI9fTEr";
---

<Layout
  title="Owner OS — a daily operating system for owner-led firms (early access)"
  description="Owner OS reads across your CRM, books, inbox, and calendar, gives you a daily brief, finds what is slipping, and drafts the next action for your approval. Early access for the first owner-led firms."
>

  <!-- HERO -->
  <section class="bg-[var(--bg-primary)] py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="font-mono text-xs px-3 py-1 rounded-full bg-[#16A34A]/10 text-[#22C55E]">EARLY ACCESS · FIRST 10 DESIGN PARTNERS</span>
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mt-5">
          Know what needs your attention today, before you open your inbox.
        </h1>
        <p class="mt-6 text-lg text-[var(--text-primary-80)] leading-relaxed">
          Owner OS reads across your CRM, books, inbox, calendar, and files. It gives you a daily brief, finds what is slipping, and drafts the next action for you to approve. Nothing goes out on its own.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href={BOOKING} target="_blank" rel="noopener noreferrer" class="inline-block bg-[#16A34A] hover:bg-[#15803D] text-white font-semibold px-8 py-4 rounded-lg text-center transition-colors shadow-[0_4px_20px_rgba(22,163,74,0.3)]">
            Join early access
          </a>
          <a href="/owneros_demo" class="inline-block border border-[var(--hover-border)] hover:border-[#22C55E] text-[var(--text-primary)] font-semibold px-8 py-4 rounded-lg text-center transition-colors">
            See the interactive demo
          </a>
        </div>
        <p class="mt-6 text-sm text-[var(--text-secondary)]">Built by Vinh Truong, CISSP. 20+ years leading enterprise IT and automation.</p>
      </div>
      <div>
        <DashboardMockup type="owner" />
      </div>
    </div>
  </section>

  <!-- OPERATOR TRAP -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">Running the whole business between the actual work</h2>
      <p class="text-center text-[var(--text-secondary)] mb-12 max-w-2xl mx-auto">Owner-led firms don't need another app to check. They need one place that tells them what is late, what is stuck, and what needs a decision.</p>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <h3 class="text-xl font-semibold mb-3">Too many tools, no single view</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">The CRM, the inbox, the books, the calendar. The answer is in there somewhere, but no one place shows you what actually needs you today.</p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <h3 class="text-xl font-semibold mb-3">Work slips through the cracks</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">The invoice that never went out. The client who never heard back. The lead that went cold while you were doing the billable work.</p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <h3 class="text-xl font-semibold mb-3">The follow-up is on you</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">Every reminder, every nudge, every next step waits on you to remember it. The business runs at the speed of your memory.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT OWNER OS DOES -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">What Owner OS does</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider mb-2">Every morning</p>
          <h3 class="text-xl font-semibold mb-3">A daily brief</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed text-sm">What is on track, what is slipping, and what needs you today. One list, before you open your inbox.</p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider mb-2">Nothing lost</p>
          <h3 class="text-xl font-semibold mb-3">Finds what slipped</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed text-sm">Stalled leads, unbilled hours, the follow-up that never went out. It surfaces the work you meant to do.</p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider mb-2">Ready to send</p>
          <h3 class="text-xl font-semibold mb-3">Drafts the next action</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed text-sm">The follow-up email, the invoice, the update. It writes the draft. You read it and approve it.</p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[#16A34A]/30 rounded-xl p-8">
          <p class="text-xs font-semibold text-[#22C55E] uppercase tracking-wider mb-2">Always</p>
          <h3 class="text-xl font-semibold mb-3">Human approval</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed text-sm">Owner OS never sends on its own. You stay in control of everything that leaves your business.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">What's included</h2>
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-xl font-semibold mb-6">The intelligence</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Daily owner brief</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Stalled lead alerts</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Unbilled work alerts</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Drafted follow-ups, ready for your approval</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Goal tracking against what matters this quarter</span></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-6">CRM included</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Capture leads and manage pipelines</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Book appointments online</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Nurture prospects and plan social content</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Unlimited contacts and users</span></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-[#16A34A] mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-[var(--text-primary-80)]">Works with the tools you already use</span></li>
          </ul>
        </div>
      </div>
      <p class="mt-10 text-center text-sm text-[var(--text-secondary)]">Connects to Google Workspace, Microsoft 365, QuickBooks, and the CRM you run today. We add connectors as design partners need them.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">How it works</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-5xl font-bold text-[#16A34A] mb-4">01</p>
          <h3 class="text-xl font-semibold mb-3">A short audit</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">We look at how you run today and where work slips. You get a clear picture of what an operating layer would catch for you.</p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-5xl font-bold text-[#16A34A] mb-4">02</p>
          <h3 class="text-xl font-semibold mb-3">We connect your tools</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">Owner OS reads across the systems you already use. Nothing is replaced. Setup is done with you, not handed to you.</p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-5xl font-bold text-[#16A34A] mb-4">03</p>
          <h3 class="text-xl font-semibold mb-3">You get your morning brief</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">Each day starts with one list of what needs you, with drafts ready to approve. You steer the business instead of chasing it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECURITY -->
  <section class="bg-[var(--bg-primary)] py-16 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Security first, by default</h2>
      <p class="text-[var(--text-primary-80)] leading-relaxed">Owner OS never sends on its own. A human approves before anything leaves your business. Your data stays yours, and access is scoped to what the work needs. Built by a CISSP who has run security for enterprise systems.</p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="font-mono text-xs px-3 py-1 rounded-full bg-[#16A34A]/10 text-[#22C55E]">EARLY ACCESS</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-5 mb-6">We are onboarding the first 10 design partners.</h2>
      <p class="text-lg text-[var(--text-primary-80)] leading-relaxed mb-10">
        If you run an owner-led firm and you are tired of holding the whole business in your head, let's talk. A 30-minute call, no pitch deck.
      </p>
      <a href={BOOKING} target="_blank" rel="noopener noreferrer" class="inline-block bg-[#16A34A] hover:bg-[#15803D] text-white font-semibold px-8 py-4 rounded-lg transition-colors shadow-[0_4px_20px_rgba(22,163,74,0.3)]">
        Join early access
      </a>
      <p class="mt-6 text-[var(--text-secondary)]">
        Or email <a href="mailto:info@zenprocess.ai" class="text-[#22C55E] hover:text-[#16A34A] transition-colors">info@zenprocess.ai</a>
      </p>
    </div>
  </section>

</Layout>
