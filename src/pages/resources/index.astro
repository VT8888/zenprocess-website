---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.filter(p => !p.data.draft).sort((a, b) => {
  const dateA = new Date(a.data.date);
  const dateB = new Date(b.data.date);
  return dateB.getTime() - dateA.getTime();
});
---

<Layout
  title="Resources – Data, AI, and Distribution Operations"
  description="Plain writing on data, AI, and running an operation. No hype. Written by Vinh, grounded in real engagements."
>
  <section class="resources-hero">
    <div class="wrap resources-hero-wrap text-center">
      <span class="kicker">Resources</span>
      <h1 class="hero-title">Plain writing on data, AI, and running an operation.</h1>
      <p class="hero-subtitle">No hype. Written by Vinh, grounded in real engagements.</p>
    </div>
  </section>

  <section class="resources-posts reveal">
    <div class="wrap">
      <div class="posts-grid">
        {posts.map(post => (
          <a href={`/resources/${post.id}`} class="card post-card">
            <p class="lbl-s post-label">{post.data.pillar || 'Article'}</p>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-desc">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="resources-cta reveal text-center">
    <div class="wrap resources-cta-wrap">
      <h2 class="cta-title">Want the short version for your business?</h2>
      <a href="https://links.zenprocess.ai/widget/booking/rcoKJifJJA46bRI9fTEr" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book a call</a>
    </div>
  </section>
</Layout>

<style>
  .resources-hero {
    padding-top: 80px;
    padding-bottom: 20px;
  }
  .resources-hero-wrap {
    max-width: 760px;
  }
  .hero-title {
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: 800;
    margin: 16px 0 14px;
  }
  .hero-subtitle {
    font-size: 19px;
    color: var(--ink-2);
  }
  .resources-posts {
    padding-top: 20px;
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .post-card {
    padding: 26px;
    text-decoration: none;
    color: inherit;
    transition: .2s;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--line-2);
  }
  .post-label {
    color: var(--green-d);
  }
  .post-title {
    font-size: 19px;
    margin: 10px 0;
  }
  .post-desc {
    color: var(--ink-2);
    font-size: 14.5px;
  }
  .resources-cta {
    border-top: 1px solid var(--line);
  }
  .resources-cta-wrap {
    max-width: 640px;
  }
  .cta-title {
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 800;
    margin-bottom: 16px;
  }
  @media(max-width:860px) {
    .posts-grid {
      grid-template-columns: 1fr !important;
      gap: 20px;
    }
  }
</style>
