---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vinhPhoto from '../assets/vinh-photo.jpg';

const BOOKING = "https://links.zenprocess.ai/widget/booking/rcoKJifJJA46bRI9fTEr";
---

<Layout
  title="AI Operating Systems for Owner-Led Firms and Distributors"
  description="zenprocess builds production-grade AI systems that sit on top of the tools you already run. Owner OS for owner-led firms (early access), and real-time data and AI for multi-warehouse distributors on SAP and similar ERPs."
>

  <!-- SECTION 1: Hero (unifying brand statement) -->
  <section class="min-h-[70vh] flex items-center bg-[var(--bg-primary)]">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <p class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-widest mb-4">Production-grade AI, not demos</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
        Give your business an operating system.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-[var(--text-primary-80)] leading-relaxed max-w-2xl mx-auto">
        We build AI systems that sit on top of the tools you already run, read what is happening, and put the truth in front of your team every morning. With human approval, always.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href={BOOKING} target="_blank" rel="noopener noreferrer" class="inline-block bg-[#16A34A] hover:bg-[#15803D] text-white font-semibold px-8 py-4 rounded-lg text-center transition-colors shadow-[0_4px_20px_rgba(22,163,74,0.3)]">
          Book a call
        </a>
        <a href="/case-study" class="inline-block border border-[var(--hover-border)] hover:border-[#22C55E] text-[var(--text-primary)] font-semibold px-8 py-4 rounded-lg text-center transition-colors">
          See the work
        </a>
      </div>
      <div class="mt-10 flex items-center justify-center flex-wrap gap-3 text-sm text-[var(--text-secondary)]">
        <Image src={vinhPhoto} alt="Vinh Truong" width={80} height={80} loading="eager" fetchpriority="high" class="w-9 h-9 rounded-full border border-[var(--hover-border)] shrink-0" />
        <span class="text-[var(--text-primary)] font-medium">Led by Vinh Truong</span>
        <span class="text-[var(--text-muted)]">·</span><span>20+ yrs VP/CTO</span>
        <span class="text-[var(--text-muted)]">·</span><span>$80M+ initiatives</span>
        <span class="text-[var(--text-muted)]">·</span><span>CISSP</span>
      </div>
    </div>
  </section>

  <!-- SECTION 2: Two-path split (the router) -->
  <section class="bg-[var(--bg-primary)] pb-20 md:pb-24 fade-up">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)] mb-8">Which are you?</p>
      <div class="grid md:grid-cols-2 gap-8">

        <!-- Owner OS -->
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[#16A34A]/30 rounded-2xl p-8 flex flex-col">
          <span class="font-mono text-xs px-3 py-1 rounded-full self-start bg-[#16A34A]/10 text-[#22C55E]">EARLY ACCESS</span>
          <h2 class="text-2xl font-bold mt-4">Owner OS</h2>
          <p class="text-sm text-[var(--text-secondary)] mt-1">For owners and small teams</p>
          <p class="mt-4 text-[var(--text-primary-80)] leading-relaxed">
            One place that tells you what is late, what is stuck, and what needs a decision. It reads your CRM, books, inbox, and calendar, then drafts the follow-up. You approve it. Nothing goes out on its own.
          </p>
          <a href="/owner-os" class="inline-block mt-6 text-[#22C55E] hover:text-[#16A34A] font-semibold transition-colors">Explore Owner OS &rarr;</a>
        </div>

        <!-- For Distributors -->
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-2xl p-8 flex flex-col">
          <span class="font-mono text-xs px-3 py-1 rounded-full self-start border border-[var(--glass-border)] text-[var(--text-secondary)]">PROVEN</span>
          <h2 class="text-2xl font-bold mt-4">For Distributors</h2>
          <p class="text-sm text-[var(--text-secondary)] mt-1">Multi-warehouse, SAP and similar ERPs</p>
          <p class="mt-4 text-[var(--text-primary-80)] leading-relaxed">
            Live dashboards and exception alerts on top of your ERP. A national building materials distributor: 3,000+ SKUs, 800+ daily exceptions flagged, 0% variance versus SAP, 16 weeks from audit to daily use.
          </p>
          <a href="/for-distributors" class="inline-block mt-6 text-[#22C55E] hover:text-[#16A34A] font-semibold transition-colors">See the enterprise track &rarr;</a>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 3: How we work (unifying method, no prices) -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">How we work</h2>
      <p class="text-center text-[var(--text-secondary)] mb-12 max-w-2xl mx-auto">Same method, both tracks. We start small, prove it on your data, then let your team run on it.</p>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-5xl font-bold text-[#16A34A] mb-4">01</p>
          <h3 class="text-xl font-semibold mb-3">Start with an audit</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">
            We map your tools and data, find what is slipping, and show you what an operating layer would catch. You get a clear plan, whether you build with us or not.
          </p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[var(--glass-border)] rounded-xl p-8">
          <p class="text-5xl font-bold text-[#16A34A] mb-4">02</p>
          <h3 class="text-xl font-semibold mb-3">Connect and prove it</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">
            We connect the systems you already use and validate against them. Nothing replaces your ERP or your tools. Your team sees real output within weeks.
          </p>
        </div>
        <div class="bg-[var(--glass-bg)] backdrop-blur-xl border border-[#16A34A]/30 rounded-xl p-8">
          <p class="text-5xl font-bold text-[#22C55E] mb-4">03</p>
          <h3 class="text-xl font-semibold mb-3">Run on it every morning</h3>
          <p class="text-[var(--text-primary-80)] leading-relaxed">
            Owners get a daily brief. Distributor teams open a live dashboard. The system flags exceptions and drafts next actions. A human approves before anything goes out.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: Shared credibility -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-2xl font-bold text-[var(--text-primary)]">20+ years</p>
          <p class="text-[var(--text-secondary)] mt-1">Enterprise IT & CTO leadership</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[var(--text-primary)]">$80M+</p>
          <p class="text-[var(--text-secondary)] mt-1">In technology initiatives delivered</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[var(--text-primary)]">Production-grade</p>
          <p class="text-[var(--text-secondary)] mt-1">Systems your team uses daily, not demos</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[var(--text-primary)]">Houston, TX</p>
          <p class="text-[var(--text-secondary)] mt-1">Founder-led</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/about" class="text-[#22C55E] hover:text-[#16A34A] font-semibold transition-colors">About us &rarr;</a>
      </div>
    </div>
  </section>

  <!-- SECTION 5: Final CTA -->
  <section class="bg-[var(--bg-primary)] py-20 md:py-24 fade-up border-t border-[var(--glass-border)]">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Tell me what is slipping. I will tell you if we can help.</h2>
      <p class="text-lg text-[var(--text-primary-80)] leading-relaxed mb-10">
        A 30-minute call, no pitch deck. We look at how you run today and whether an operating layer is worth it for you.
      </p>
      <a href={BOOKING} target="_blank" rel="noopener noreferrer" class="inline-block bg-[#16A34A] hover:bg-[#15803D] text-white font-semibold px-8 py-4 rounded-lg transition-colors shadow-[0_4px_20px_rgba(22,163,74,0.3)]">
        Book a call
      </a>
      <p class="mt-6 text-[var(--text-secondary)]">
        Or email <a href="mailto:info@zenprocess.ai" class="text-[#22C55E] hover:text-[#16A34A] transition-colors">info@zenprocess.ai</a> | <a href="tel:+18329742818" class="text-[#22C55E] hover:text-[#16A34A] transition-colors">(832) 974-2818</a>
      </p>
    </div>
  </section>

</Layout>
