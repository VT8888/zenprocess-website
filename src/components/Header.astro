---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/owner-os', label: 'OwnerOS' },
  { href: '/for-distributors', label: 'For Distributors' },
  { href: '/case-study', label: 'Case Study' },
  { href: '/about', label: 'About' },
  { href: '/resources', label: 'Resources' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site">
  <div class="wrap row">
    <a href="/" class="logo"><Image src={logo} alt="zenprocess.ai" width={30} height={30} style="display:block;flex:none" />zenprocess.ai</a>
    <nav class="main" id="desktop-nav">
      {navLinks.map((link) => (
        <a href={link.href} class:list={{ active: isActive(link.href) }}>
          {link.label}
        </a>
      ))}
      <a class="btn btn-primary nav-cta" style="padding:9px 16px;font-size:14px" href="https://links.zenprocess.ai/widget/booking/rcoKJifJJA46bRI9fTEr" target="_blank" rel="noopener noreferrer">Book a demo</a>
    </nav>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="mobile-only"
      aria-label="Toggle menu"
      aria-expanded="false"
      style="border:none;background:transparent;cursor:pointer;color:var(--ink-2);display:none"
    >
      <svg id="hamburger-icon" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="close-icon" style="width:24px;height:24px;display:none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" style="display:none;padding:0 24px 16px;flex-direction:column;gap:12px">
    {navLinks.map((link) => (
      <a href={link.href} style="font-size:14.5px;font-weight:500;color:var(--ink-2);text-decoration:none">
        {link.label}
      </a>
    ))}
    <a class="btn btn-primary" style="padding:9px 16px;font-size:14px;margin-top:8px" href="https://links.zenprocess.ai/widget/booking/rcoKJifJJA46bRI9fTEr" target="_blank" rel="noopener noreferrer">Book a demo</a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.style.display === "flex";
    if (menu) menu.style.display = isOpen ? "none" : "flex";
    if (hamburgerIcon) hamburgerIcon.style.display = isOpen ? "block" : "none";
    if (closeIcon) closeIcon.style.display = isOpen ? "none" : "block";
    btn.setAttribute("aria-expanded", String(!isOpen));
  });
</script>

<style>
  /* Desktop nav holds down to 720px; hamburger only below that (Oscar zoom headroom) */
  @media (max-width: 720px) {
    nav.main {
      display: none !important;
    }
    .mobile-only {
      display: block !important;
    }
  }
  @media (min-width: 721px) {
    .mobile-only,
    #mobile-menu {
      display: none !important;
    }
    nav.main {
      display: flex !important;
    }
  }
  /* Tighten the nav in the 721-1024 band so 5 links + logo fit on one line */
  @media (max-width: 1024px) {
    nav.main { gap: 16px; }
    .logo { font-size: 17px; }
  }
  /* The CTA button needs the most room; show it only on wider desktops */
  @media (max-width: 900px) {
    .nav-cta { display: none; }
  }
  /* Keep the CTA text white to match the "Book a call" button — the generic
     `nav.main a{color:var(--ink-2)}` rule was tinting it dark gray. */
  nav.main a.nav-cta,
  nav.main a.nav-cta:hover { color: #fff; }
</style>
