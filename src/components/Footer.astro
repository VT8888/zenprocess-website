---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/owner-os", label: "OwnerOS" },
  { href: "/for-distributors", label: "For Distributors" },
  { href: "/case-study", label: "Case Study" },
  { href: "/about", label: "About" },
  { href: "/resources", label: "Resources" },
];

const currentYear = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo" style="font-size:17px"><img src="/logo.png" alt="zenprocess.ai" width="24" height="24" style="display:block;flex:none" />zenprocess.ai</a>
      <p class="footer-desc">AI systems built on the tools you already use. OwnerOS for owner-led firms, ERP Intelligence for distributors.</p>
    </div>

    <div>
      <h3 class="footer-h">Navigation</h3>
      <ul class="footer-list">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="footer-h">Contact</h3>
      <ul class="footer-list">
        <li><a href="mailto:info@zenprocess.ai">info@zenprocess.ai</a></li>
        <li><a href="tel:+18329742818">(832) 974-2818</a></li>
        <li class="footer-muted">Houston, TX</li>
        <li><a href="https://www.linkedin.com/in/vttruong/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; {currentYear} KMV Group LLC dba zenprocess.ai. All rights reserved.</p>
    <div class="footer-legal">
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-service">Terms of Service</a>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
  }
  .footer-desc {
    margin-top: 12px;
    font-size: 14px;
    color: var(--muted);
    max-width: 36ch;
    line-height: 1.6;
  }
  .footer-h {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-list a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
  }
  .footer-list a:hover {
    color: var(--green-d);
  }
  .footer-muted {
    color: var(--muted);
    font-size: 14px;
  }
  .footer-bottom {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
  }
  .footer-legal {
    display: flex;
    gap: 18px;
  }
  .footer-legal a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-legal a:hover {
    color: var(--green-d);
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
